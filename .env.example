# --- Database (Supabase) ---
# Supabase > Project settings > Database > Connection string. On Vercel use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Portal ---
APP_NAME=D365 Reports Portal
# Long random string used to sign sign-in sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Company shown first when a user opens the portal
DEFAULT_COMPANY=usmf

# --- D365 F&O OData (live sync) ---
D365_URL=https://yourenv.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
# Companies (legal entities) to sync, comma separated
SYNC_COMPANIES=usmf,demf
# Vercel cron calls /api/cron/sync with this as a Bearer token
CRON_SECRET=
